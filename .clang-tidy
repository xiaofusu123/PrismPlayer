# 静态检查规则集 —— 见 docs/adr/0002-代码门禁.md 决策 2 / docs/markdown/代码规范.md §0
#
# 只启用四条：命名约定（§1.1-1.3）、函数长度（§5.1）、多态基类虚析构（§4.6）、
# 平凡特殊成员函数（#85 的第一条新规则，见下）。
# 四条都设为致命错误；后续加规则走「先加检查 → 先清零 → 再启用」，一次一条。
# 本文件由 pre-push 钩子消费（pre-commit 不跑 clang-tidy，理由见 ADR 决策 3）。
---
Checks: >
  -*,
  readability-identifier-naming,
  readability-function-size,
  cppcoreguidelines-virtual-class-destructor,
  modernize-use-equals-default

WarningsAsErrors: >
  readability-identifier-naming,
  readability-function-size,
  cppcoreguidelines-virtual-class-destructor,
  modernize-use-equals-default

CheckOptions:
  # §1.1 类名、结构体名、枚举名、别名 —— PascalCase（clang-tidy 的 CamelCase 即首字母大写）
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.TypedefCase: CamelCase
  # §1.2 函数名、变量名 —— snake_case
  readability-identifier-naming.FunctionCase: lower_case
  readability-identifier-naming.VariableCase: lower_case
  readability-identifier-naming.ParameterCase: lower_case
  # §1.3 宏、常量 —— 全大写
  readability-identifier-naming.MacroDefinitionCase: UPPER_CASE
  readability-identifier-naming.ConstantCase: UPPER_CASE
  # §5.1 函数 ≤100 行
  readability-function-size.LineThreshold: 100
...
