{
  "version": 10,
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "$env{CLANG_ROOT}/clang.exe",
        "CMAKE_CXX_COMPILER": "$env{CLANG_ROOT}/clang++.exe",
        "CMAKE_MAKE_PROGRAM": "$env{CLANG_ROOT}/ninja.exe",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/vcpkg-toolchain.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-mingw-dynamic",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      },
      "environment": {
        "CC": "clang",
        "CXX": "clang++",
        "VCPKG_BINARY_SOURCES": "clear;files,${sourceDir}/.vcpkg-cache,readwrite"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_MAKE_PROGRAM": "ninja",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/vcpkg-toolchain.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      },
      "environment": {
        "CC": "clang",
        "CXX": "clang++",
        "VCPKG_BINARY_SOURCES": "clear;files,${sourceDir}/.vcpkg-cache,readwrite"
      }
    },

    {
      "name": "windows-clang-x64-Debug",
      "binaryDir": "${sourceDir}/build/Windows/debug",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VCPKG_MANIFEST_FEATURES": "client;server;test"
      }
    },
    {
      "name": "windows-clang-x64-Release",
      "binaryDir": "${sourceDir}/build/Windows/release",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_MANIFEST_FEATURES": "client;server"
      }
    },

    {
      "name": "linux-clang-x64-Debug",
      "binaryDir": "${sourceDir}/build/Linux/debug",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VCPKG_MANIFEST_FEATURES": "client;server;test"
      }
    },
    {
      "name": "linux-clang-x64-Release",
      "binaryDir": "${sourceDir}/build/Linux/release",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_MANIFEST_FEATURES": "client;server"
      }
    }
  ],

  "buildPresets": [
    {
      "name": "windows-clang-x64-Debug",
      "configurePreset": "windows-clang-x64-Debug"
    },
    {
      "name": "windows-clang-x64-Release",
      "configurePreset": "windows-clang-x64-Release"
    },

    {
      "name": "linux-clang-x64-Debug",
      "configurePreset": "linux-clang-x64-Debug"
    },
    {
      "name": "linux-clang-x64-Release",
      "configurePreset": "linux-clang-x64-Release"
    }
  ]
}
