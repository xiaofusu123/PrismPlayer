{
  "name": "prism-player",
  "version": "0.0.1",
  "default-features": [
    "client"
  ],
  "features": {
    "client": {
      "description": "客户端依赖",
      "dependencies": [
        "asio",
        "ffmpeg",
        "glfw3",
        "glm",
        "ixwebsocket",
        "nlohmann-json",
        "openssl",
        "soundtouch",
        "spdlog",
        "sqlite3",
        "vulkan"
      ]
    },
    "server": {
      "description": "服务端依赖",
      "dependencies": [
        "asio",
        "ixwebsocket",
        "nlohmann-json",
        "openssl",
        "spdlog"
      ]
    },
    "mysql": {
      "description": "MySQL 数据库适配器（仅 Linux：libmysql 不支持 x64-mingw-dynamic）",
      "dependencies": [
        "libmysql"
      ]
    },
    "test": {
      "description": "单元测试 (GTest)",
      "dependencies": [
        "gtest"
      ]
    }
  }
}
